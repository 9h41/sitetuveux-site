<section class="contact-page">
  <div class="contact-top-logo">
    <img src="https://static.wixstatic.com/media/733c96_4f6dcda493e54ffda8212b5a872f58d4~mv2.png/v1/crop/x_0,y_59,w_1080,h_963/fill/w_248,h_221,al_c,q_85,usm_0.66_1.00_0.01,enc_avif,quality_auto/Coding%20gouter%20(3).png" alt="Site tu veux" />
  </div>

  <div class="contact-marquee-wrap" aria-hidden="true">
    <p class="contact-marquee">
      <span>Si tu veux nous contacter</span>
      <span class="sep">❤</span>
      <span>Si tu veux nous contacter</span>
      <span class="sep">❤</span>
      <span>Si tu veux nous contacter</span>
      <span class="sep">❤</span>
      <span>Si tu veux nous contacter</span>
      <span class="sep">❤</span>
      <span>Si tu veux nous contacter</span>
    </p>
  </div>

  <div class="contact-card">
    <form class="contact-form" action="mailto:contact@sitetuveux.com" method="post" enctype="text/plain">
      <label for="first-name">Prénom</label>
      <input id="first-name" name="prenom" type="text" />

      <label for="last-name">Nom</label>
      <input id="last-name" name="nom" type="text" />

      <label for="email">Email *</label>
      <input id="email" name="email" type="email" required />

      <label for="website">Site web (si vous en avez un)</label>
      <input id="website" name="site_web" type="url" />

      <label for="message">Message *</label>
      <textarea id="message" name="message" required></textarea>

      <button type="submit">Envoyer</button>
    </form>
  </div>

  <p class="contact-thanks">Merci</p>
</section>
